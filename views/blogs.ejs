<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/head.ejs") %>
<body>

  <!-- Nav Bar -->
  <%- include("./partials/nav.ejs") %>

  <!-- Blog Section -->
  <div class="blogs">
    <h2>All Blogs</h2>

    <!-- condition to check if there are blogs -->
    <% if (blogs && blogs.length > 0) { %>

      <!-- Looping through the blogs array -->
      <% blogs.forEach((blog, index) => { %>
        <div class="blog">
          <!-- First blog links to home, others use "#" / not an actual page yet -->
          <h3>
            <a href="<%= index === 0 ? '/' : '#' %>">
              <%= blog.title %>
            </a>
          </h3>
          <p><%= blog.snippet %></p>
        </div>
      <% }) %>

    <% } else { %>
      <!-- Fallback if no blogs -->
      <p>There are no blogs to display.</p>
    <% } %>
  </div>

  <!-- Footer -->
  <%- include("./partials/footer.ejs") %>
</body>
</html>
