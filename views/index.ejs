<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Dynamically sets the page title using EJS -->
    <title>N4 | <%= title %></title>
</head>
<body>

    <!-- Nav Bar -->
    <nav>
        <!-- Site title and subtitle -->
        <div class="site-title">
            <!-- Clicking the title redirects to the home page -->
            <a href="/"><h1>Trends in Application Development</h1></a>
            <p>
                Lorem ipsum, dolor sit amet consectetur adipisicing elit. 
                Porro dolores laboriosam modi vero mollitia sit praesentium dolore! 
                Nostrum temporibus eaque ea pariatur soluta nam totam asperiores. 
                At iste labore unde.
            </p>
        </div>

        <!-- Nav links -->
        <ul>
            <li><a href="/blogs">Blogs</a></li>       
            <li><a href="/about">About</a></li>         
            <li><a href="/blogs/create">New Blog</a></li>
        </ul>
    </nav>

    <!-- Listing Section -->
    <div class="blogs">
        <% if (blogs.length > 0) { %>
            <!-- Loops through each blog and renders it -->
            <% blogs.forEach(blog => { %>
                <div class="blog">
                    <h3><%= blog.title %></h3>   <!-- Blog title -->
                    <p><%= blog.snippet %></p>   <!-- Short description/snippet -->
                </div>
            <% }); %>
        <% } else { %>
            <!-- Shown if no blogs exist -->
            <p>There are no blogs to display.</p>
        <% } %>
    </div>

    <!-- Reuses footer layout from a partial file -->
    <%- include("./partials/footer.ejs") %>

</body>
</html>
